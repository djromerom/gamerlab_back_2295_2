# ============================================================================
# .env.example (back). Copiar a .env y completar. NUNCA poner valores reales aqui.
#
# Cada variable lleva su bloque de comentarios justo encima, sin lineas en blanco:
#   Que:         para que sirve
#   Obligatoria: cuando hace falta (y que pasa si falta)
#   Obtener:     de donde sale el valor (sin pegar el valor)
#   Rotar:       como cambiarlo y que hay que actualizar despues
# El chequeo `npm run check:env` falla si usas una variable en el codigo y no esta
# aqui, o si a una variable le falta alguno de esos cuatro campos.
# Tras cambiar el .env del servidor hay que RECREAR el contenedor: un `docker restart` no relee el archivo.
# Tabla general, accesos y quien da cada acceso: docs de accesos del proyecto
# (variables-y-accesos). Los valores de test/prod viven en el .env del servidor.
# ============================================================================

# ---- Aplicacion ------------------------------------------------------------

# FRONTEND_URL
# Que: URL base del front. Se usa para CORS, el websocket y las redirecciones tras login.
# Obligatoria: si. Sin ella el front del ambiente no puede llamar a la API.
# Obtener: local http://localhost:5173; test/prod, la URL publica del front de ese ambiente.
# Rotar: no es secreto. Cambiarla en el .env del servidor y recrear el contenedor.
FRONTEND_URL=

# NODE_ENV
# Que: ambiente. Con `development` se simulan los correos, se deja pasar reCAPTCHA sin clave, se usa Azurite para los archivos y las cookies no van como `secure`. Swagger se expone en todo valor distinto de `production`.
# Obligatoria: si.
# Obtener: development en local; production en el servidor (confirmar el valor exacto que usa test).
# Rotar: no aplica.
NODE_ENV=development

# PORT
# Que: puerto interno de la API dentro del contenedor.
# Obligatoria: no (por defecto 3000). Los puertos del servidor los fija el docker run, no esta variable.
# Obtener: dejar 3000.
# Rotar: no aplica.
PORT=3000

# TRUST_PROXY
# Que: saltos de proxy confiables (1 = un proxy). Hace que req.ip sea la IP real del cliente para los limites por IP.
# Obligatoria: en test/prod si (hay nginx delante). Sin ella todos los usuarios comparten un solo limite de peticiones.
# Obtener: poner 1 detras del nginx del servidor; en local no se usa.
# Rotar: no aplica.
TRUST_PROXY=

# ---- Base de datos -----------------------------------------------------------

# DATABASE_URL
# Que: cadena de conexion a PostgreSQL.
# Obligatoria: si. Sin ella no arrancan ni la API ni `prisma migrate deploy`.
# Obtener: local, docker compose ya la fija hacia el contenedor `db`; test/prod, la del .env del servidor (pedir al responsable del servidor).
# Rotar: cambiar la contrasena del usuario en PostgreSQL, actualizar esta variable en el .env del servidor y recrear el contenedor.
DATABASE_URL=

# ---- Sesion y tokens ---------------------------------------------------------

# JWT_SECRET
# Que: clave con la que se firman los tokens de acceso.
# Obligatoria: si.
# Obtener: generarla al azar (`openssl rand -hex 32`); un valor distinto por ambiente. En local sirve cualquiera.
# Rotar: generar una nueva, ponerla en el .env del servidor y recrear el contenedor. Invalida los tokens de acceso vigentes.
JWT_SECRET=

# SOCKET_KEY_SECRET
# Que: secreto con el que se deriva el identificador opaco de cada usuario para los websockets (src/common/utils/opaque-user-key.ts).
# Obligatoria: en produccion si; la API falla al arrancar sin ella. En development usa uno fijo y avisa en el log.
# Obtener: generarla al azar (`openssl rand -hex 32`, 64 caracteres hex); un valor distinto por ambiente.
# Rotar: generar una nueva y recrear el contenedor. Cambia los identificadores derivados de todos los usuarios.
SOCKET_KEY_SECRET=

# ACCESS_TOKEN_EXPIRATION_MINUTES
# Que: vida del token de acceso, en minutos.
# Obligatoria: no (por defecto 15; vacio o invalido tambien cae a 15).
# Obtener: dejar vacio salvo que se decida otra duracion.
# Rotar: no es secreto. Cambiar en el .env y recrear el contenedor.
ACCESS_TOKEN_EXPIRATION_MINUTES=

# REFRESH_TOKEN_EXPIRATION_DAYS
# Que: vida del refresh token, en dias.
# Obligatoria: no (por defecto 7; vacio o invalido tambien cae a 7).
# Obtener: dejar vacio salvo que se decida otra duracion.
# Rotar: no es secreto. Cambiar en el .env y recrear el contenedor.
REFRESH_TOKEN_EXPIRATION_DAYS=

# REGISTRATION_TOKEN_EXPIRATION
# Que: vida del token de verificacion por correo, en horas.
# Obligatoria: no (por defecto 24).
# Obtener: dejar vacio salvo que se decida otra duracion.
# Rotar: no es secreto. Cambiar en el .env y recrear el contenedor.
REGISTRATION_TOKEN_EXPIRATION=

# USER_PROFILE_CACHE_TTL
# Que: tiempo que se cachea el perfil de usuario, en minutos.
# Obligatoria: no (por defecto 15).
# Obtener: dejar vacio salvo que se decida otro valor.
# Rotar: no es secreto. Cambiar en el .env y recrear el contenedor.
USER_PROFILE_CACHE_TTL=

# CACHE_SERVICE_CONFIG_TTL_MINUTES
# Que: minutos que el guard de permisos cachea la configuracion de servicios.
# Obligatoria: no (por defecto 120).
# Obtener: dejar vacio salvo que se decida otro valor.
# Rotar: no es secreto. Cambiar en el .env y recrear el contenedor.
CACHE_SERVICE_CONFIG_TTL_MINUTES=

# CACHE_USER_PERMISSIONS_TTL_MINUTES
# Que: minutos que el guard de permisos cachea los permisos de cada usuario.
# Obligatoria: no (por defecto 60).
# Obtener: dejar vacio salvo que se decida otro valor.
# Rotar: no es secreto. Cambiar en el .env y recrear el contenedor.
CACHE_USER_PERMISSIONS_TTL_MINUTES=

# CACHE_PERMISSION_CHECK_TTL_MINUTES
# Que: minutos que el guard de permisos cachea el resultado de cada comprobacion.
# Obligatoria: no (por defecto 30).
# Obtener: dejar vacio salvo que se decida otro valor.
# Rotar: no es secreto. Cambiar en el .env y recrear el contenedor.
CACHE_PERMISSION_CHECK_TTL_MINUTES=

# ADMIN_ROLE_NAME
# Que: nombre del rol que el guard de permisos trata como administrador.
# Obligatoria: no (por defecto "Administrador").
# Obtener: dejar vacio; debe coincidir con el nombre del rol en la base de datos.
# Rotar: no es secreto. Cambiarlo solo junto con el nombre del rol en la BD.
ADMIN_ROLE_NAME=

# ---- reCAPTCHA (Google) --------------------------------------------------------

# RECAPTCHA_SECRET_KEY
# Que: clave secreta de reCAPTCHA v3 con la que el back valida el formulario de registro.
# Obligatoria: si; el servicio de reCAPTCHA falla al iniciar sin ella.
# Obtener: consola de administracion de reCAPTCHA de Google, en el sitio de Arkad (cuenta duena del sitio: pendiente de confirmar). Debe ser el par de la clave publica VITE_SITE_KEY del front.
# Rotar: en la consola de reCAPTCHA, regenerar la clave del sitio; actualizar esta variable y VITE_SITE_KEY (y reconstruir el front).
RECAPTCHA_SECRET_KEY=

# RECAPTCHA_URL
# Que: endpoint de verificacion de Google.
# Obligatoria: no (por defecto https://www.google.com/recaptcha/api/siteverify).
# Obtener: dejar vacio.
# Rotar: no aplica.
RECAPTCHA_URL=

# RECAPTCHA_SCORE
# Que: puntaje minimo (0 a 1) para aceptar una peticion como humana.
# Obligatoria: no (por defecto 0.5; avisa en el log si no hay un valor valido).
# Obtener: dejar vacio salvo que se decida otro umbral.
# Rotar: no es secreto. Cambiar en el .env y recrear el contenedor.
RECAPTCHA_SCORE=

# ---- Correo (Azure Communication Services) --------------------------------------

# ACS_CONNECTION_STRING
# Que: cadena de conexion del recurso de Azure Communication Services con el que se envian los correos.
# Obligatoria: en test/prod si; sin ella el envio responde 503. Solo en development se simula el envio.
# Obtener: portal de Azure, recurso de Communication Services, seccion Keys (nombre exacto del recurso: pendiente de confirmar).
# Rotar: en el portal, regenerar la clave; actualizar esta variable en el .env del servidor y recrear el contenedor.
ACS_CONNECTION_STRING=

# ACS_SENDER_ADDRESS
# Que: direccion remitente verificada en el dominio de correo de ACS.
# Obligatoria: junto con ACS_CONNECTION_STRING.
# Obtener: portal de Azure, dominio de correo asociado al recurso, direcciones MailFrom.
# Rotar: no es secreto. Cambiar si se cambia el dominio o el remitente.
ACS_SENDER_ADDRESS=

# ---- Archivos (Azure Blob Storage) -----------------------------------------------

# AZURE_CONTAINER
# Que: nombre del contenedor de blobs donde se guardan los archivos subidos.
# Obligatoria: si, en todos los ambientes; sin ella la API falla al iniciar.
# Obtener: portal de Azure, cuenta de almacenamiento, Containers (en local, el que se cree en Azurite).
# Rotar: no es secreto. Si se cambia de contenedor hay que migrar las referencias (scripts/migrate-blob-references.ts).
AZURE_CONTAINER=

# AZURE_ACCOUNT_NAME
# Que: nombre de la cuenta de almacenamiento de Azure.
# Obligatoria: en test/prod si; en development no se usa (se toma de AZURE_STORAGE_CONNECTION_STRING).
# Obtener: portal de Azure, cuenta de almacenamiento.
# Rotar: no es secreto. Cambia solo si se cambia de cuenta.
AZURE_ACCOUNT_NAME=

# AZURE_ACCOUNT_KEY
# Que: clave de acceso de la cuenta de almacenamiento.
# Obligatoria: en test/prod si; en development no se usa.
# Obtener: portal de Azure, cuenta de almacenamiento, Access keys.
# Rotar: en el portal, regenerar key1 o key2 (hay dos para rotar sin corte); actualizar esta variable en el .env del servidor y recrear el contenedor.
AZURE_ACCOUNT_KEY=

# AZURE_STORAGE_CONNECTION_STRING
# Que: cadena de conexion al emulador Azurite, usada solo cuando NODE_ENV=development.
# Obligatoria: solo en development; sin ella la API falla al iniciar en local.
# Obtener: es la cadena por defecto publicada en la documentacion de Azurite (no es un secreto real); el docker-compose.dev la usa.
# Rotar: no aplica.
AZURE_STORAGE_CONNECTION_STRING=

# ---- Login con Microsoft (Azure Entra ID) -----------------------------------------
# Las cuatro son obligatorias: el servicio de autenticacion lanza error al iniciar si falta alguna.

# AZURE_TENANT_ID
# Que: identificador del tenant de Microsoft Entra ID contra el que se inicia sesion.
# Obligatoria: si, en todos los ambientes.
# Obtener: portal de Azure, Microsoft Entra ID, Overview (o la pagina del App registration).
# Rotar: no es secreto. Cambia solo si se cambia de tenant.
AZURE_TENANT_ID=

# AZURE_CLIENT_ID
# Que: identificador (Application/client ID) del App registration de Arkad en Entra ID.
# Obligatoria: si, en todos los ambientes.
# Obtener: portal de Azure, Microsoft Entra ID, App registrations, la app de Arkad (nombre: pendiente de confirmar).
# Rotar: no es secreto. Cambia solo si se crea otro App registration.
AZURE_CLIENT_ID=

# AZURE_CLIENT_SECRET
# Que: secreto del App registration con el que el back canjea el codigo de login de Microsoft.
# Obligatoria: si, en todos los ambientes.
# Obtener: portal de Azure, App registration, Certificates & secrets. El valor solo se ve al crearlo; si se perdio, crear uno nuevo.
# Rotar: los secretos de Entra ID caducan. Crear uno nuevo antes de la fecha de vencimiento, actualizar esta variable en el .env del servidor, recrear el contenedor y luego borrar el viejo.
AZURE_CLIENT_SECRET=

# REDIRECT_URI
# Que: URL de retorno a la que Microsoft devuelve al usuario tras el login. Debe coincidir exactamente con una registrada en el App registration.
# Obligatoria: si, en todos los ambientes (una distinta por ambiente).
# Obtener: la registrada en el portal de Azure, App registration, Authentication, Redirect URIs.
# Rotar: no es secreto. Si cambia, actualizarla en el portal y aqui a la vez.
REDIRECT_URI=

# ---- Certificados PDF (Gotenberg) -------------------------------------------------

# GOTENBERG_URL
# Que: URL del servicio Gotenberg que convierte las plantillas HTML en PDF de certificados.
# Obligatoria: solo para generar certificados.
# Obtener: en local la fija docker-compose.dev (http://gotenberg:3000); en test/prod, la del contenedor Gotenberg del servidor (pendiente de confirmar).
# Rotar: no es secreto.
GOTENBERG_URL=

# ---- Datos del evento (correos y certificados) ------------------------------------

# EVENT_DATE_TEXT
# Que: fecha del evento, como texto libre (por ejemplo "27 de noviembre"), para el correo de verificacion y los certificados.
# Obligatoria: recomendada. Sin ella el correo de verificacion omite fecha, hora y lugar y los certificados no se generan.
# Obtener: la define la organizacion de la feria cada edicion.
# Rotar: no es secreto. Actualizar cada edicion en el .env del servidor y recrear el contenedor.
EVENT_DATE_TEXT=

# EVENT_TIME_TEXT
# Que: horario del evento, como texto libre (por ejemplo "9:00 am - 1:00 pm").
# Obligatoria: recomendada, igual que EVENT_DATE_TEXT.
# Obtener: la define la organizacion de la feria cada edicion.
# Rotar: no es secreto. Actualizar cada edicion y recrear el contenedor.
EVENT_TIME_TEXT=

# EVENT_PLACE_TEXT
# Que: lugar del evento, como texto libre.
# Obligatoria: recomendada, igual que EVENT_DATE_TEXT.
# Obtener: la define la organizacion de la feria cada edicion.
# Rotar: no es secreto. Actualizar cada edicion y recrear el contenedor.
EVENT_PLACE_TEXT=

# ---- Seed de la base de datos (solo desarrollo) -------------------------------------
# El seed (`npm run db:seed`) no corre con NODE_ENV=production. Estas contrasenas son solo
# para los usuarios de prueba que crea; confirmar si el ambiente de test ejecuta el seed.

# ADMIN_PASSWORD
# Que: contrasena inicial del usuario administrador que crea el seed.
# Obligatoria: no. Si falta, el seed usa un valor por defecto de desarrollo (no usarlo fuera de local).
# Obtener: elegir una cualquiera para local; nunca reutilizar la de un usuario real.
# Rotar: cambiarla en la aplicacion; este valor solo se lee al crear el usuario por primera vez.
ADMIN_PASSWORD=

# PROFESOR_COLEGIOS_PASSWORD
# Que: contrasena inicial del usuario profesor de colegios que crea el seed.
# Obligatoria: no. Si falta, el seed usa un valor por defecto de desarrollo.
# Obtener: elegir una cualquiera para local; nunca reutilizar la de un usuario real.
# Rotar: cambiarla en la aplicacion; este valor solo se lee al crear el usuario por primera vez.
PROFESOR_COLEGIOS_PASSWORD=
