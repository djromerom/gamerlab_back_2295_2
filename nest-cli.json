{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "**/*.html",
        "watchAssets": true
      },
      {
        "include": "certificates/assets/**/*",
        "outDir": "dist"
      }
    ]
  },
  "watchOptions": {
    "usePolling": true,
    "interval": 1000
  }
}
