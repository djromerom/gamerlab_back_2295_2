            font-size: 16px;
            line-height: 1.7;
        }

        .content strong {
            color: #f8fafc;
            font-weight: 600;
        }

        .highlight {
            background: rgba(245, 158, 11, 0.1);
            border: 1px solid rgba(245, 158, 11, 0.3);
            padding: 15px;
            border-radius: 8px;
            margin: 20px 0;
            color: #fcd34d;
