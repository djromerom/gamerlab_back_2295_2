        margin-top: 10px;
        letter-spacing: 0.5px;
      }
      p {
        line-height: 1.6;
        text-align: center;
        font-size: 1.05em;
        color: #444;
      }
      strong {
        color: #5a3aff;
      }
      .footer {
        font-size: 0.85em;
        color: #777;
        text-align: center;
        margin-top: 35px;
        border-top: 1px solid #eee;
        padding-top: 15px;
      }
      @keyframes fadeIn {
        from {
          opacity: 0;
          transform: translateY(10px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }
      @media (max-width: 600px) {
        .container {
          padding: 10vw 2vw;
          max-width: 98vw;
        }
        .logo {
