generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["views"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EditionStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

model Edition {
  id Int @id @default(autoincrement()) @map("id_edicion")

  year     Int @map("año")
  semester Int @map("semestre")
  // 10 = primer semestre, 20 = intersemestral, 30 = segundo semestre

  title        String   @map("titulo") @db.VarChar(100)
  description  String?  @map("descripcion")
  description2 String?  @map("descripcion2")
  alt          String?  @map("alt") @db.VarChar(100)
  mainPhoto    String?  @map("foto_principal")
  photos       String[] @default([]) @map("fotos")

  startsAt DateTime @map("inicia_en")
  endsAt   DateTime @map("termina_en")

  status    EditionStatus @default(INACTIVE) @map("estado")
  createdAt DateTime @default(now()) @map("creado_en")
  updatedAt DateTime @updatedAt @map("actualizado_en")

  highlightedGames   HighlightedGame[]
  eventConfiguration EventConfiguration?
  educationalFocuses EducationalFocus[]
  teams              Team[]
  evaluations        Evaluation[]
  nrcs               NRC[]
  weighting          Weighting?
  testimonials       Testimonial[]
  rankingResults     RankingResult[]
  HistoricalTeam     HistoricalTeam[]
  jurorBadges        JurorBadge[]
  jurorAttendances   JurorAttendance[]
  jurorEditions      JurorEdition[]

  @@unique([year, semester])
  @@map("ediciones")
}

model EventConfiguration {
  id              Int      @id @default(autoincrement())
  evaluationsOpen Boolean  @default(false) @map("evaluaciones_abiertas")
  createdAt       DateTime @default(now()) @map("creado_en")
  updatedAt       DateTime @updatedAt @map("actualizado_en")
  editionId       Int      @unique @map("id_edicion")
  showEvaluations Boolean  @default(false) @map("mostrar_evaluaciones")
  showRanking     Boolean  @default(false) @map("mostrar_ranking")
  registrationsOpen Boolean @default(false) @map("inscripciones_abiertas")
  edition         Edition  @relation(fields: [editionId], references: [id])

  @@map("configuracion_evento")
}

model TokenType {
  id                 Int                 @id @default(autoincrement())
  type               String              @unique @map("tipo")
  isActive           Boolean             @default(true) @map("activo")
  createdAt          DateTime            @default(now()) @map("creado_en")
  updatedAt          DateTime            @updatedAt @map("actualizado_en")
  verificationTokens VerificationToken[]

  @@map("tipo_token")
}

model VerificationToken {
  id          String    @id @default(uuid())
  token       String    @unique
  email       String
  userId      String    @map("user_id")
  tokenTypeId Int       @map("tipo_id")
  expiresAt   DateTime  @map("expira_en")
  createdAt   DateTime  @default(now()) @map("creado_en")
  updatedAt   DateTime  @updatedAt @map("actualizado_en")
  type        TokenType @relation(fields: [tokenTypeId], references: [id])

  @@index([email, tokenTypeId])
  @@map("token_verificacion")
}

// Refresh tokens emitidos (solo el sha256, nunca el token). Permite rotarlos y revocarlos.
model RefreshToken {
  id            String                    @id @default(uuid())
  userId        String                    @map("user_id")
  tokenHash     String                    @unique @map("token_hash")
  expiresAt     DateTime                  @map("expira_en")
  revokedAt     DateTime?                 @map("revocado_en")
  // ROTATED tiene ventana de gracia (reintentos del front); LOGOUT y REUSE no.
  revokedReason RefreshTokenRevokeReason? @map("motivo_revocacion")
  createdAt     DateTime                  @default(now()) @map("creado_en")
  user          User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_token")
}

enum RefreshTokenRevokeReason {
  ROTATED
  LOGOUT
  REUSE
}

model Role {
  id              Int              @id @default(autoincrement()) @map("id_rol")
  name            String           @unique @map("rol")
  description     String?          @map("descripcion")
  createdAt       DateTime         @default(now()) @map("creado_en")
  updatedAt       DateTime         @updatedAt @map("actualizado_en")
  isActive        Boolean          @default(true) @map("activo")
  rolePermissions RolePermission[]
  users           User[]

  @@map("roles")
}

model Service {
  id                 Int                 @id @default(autoincrement()) @map("id_servicio")
  name               String              @unique @map("nombre")
  description        String?             @map("descripcion")
  url                String?             @map("url")
  method             String?             @map("metodo") @db.VarChar(10)
  createdAt          DateTime            @default(now()) @map("creado_en")
  updatedAt          DateTime            @updatedAt @map("actualizado_en")
  isActive           Boolean             @default(true) @map("activo")
  servicePermissions ServicePermission[]

  @@map("servicio")
}

model Permission {
  id                 Int                 @id @default(autoincrement()) @map("id_permiso")
  name               String              @unique @map("nombre")
  description        String?             @map("descripcion")
  createdAt          DateTime            @default(now()) @map("creado_en")
  updatedAt          DateTime            @updatedAt @map("actualizado_en")
  isActive           Boolean             @default(true) @map("activo")
  rolePermissions    RolePermission[]
  servicePermissions ServicePermission[]

  @@map("permisos")
}

model RolePermission {
  roleId       Int        @map("id_rol")
  permissionId Int        @map("id_permiso")
  createdAt    DateTime   @default(now()) @map("creado_en")
  updatedAt    DateTime   @default(now()) @updatedAt @map("actualizado_en")
  isActive     Boolean    @default(true) @map("activo")
  permission   Permission @relation(fields: [permissionId], references: [id])
  role         Role       @relation(fields: [roleId], references: [id])

  @@id([roleId, permissionId])
  @@map("rol_permiso")
}

model ServicePermission {
  serviceId    Int        @map("id_servicio")
  permissionId Int        @map("id_permiso")
  createdAt    DateTime   @default(now()) @map("creado_en")
  updatedAt    DateTime   @default(now()) @updatedAt @map("actualizado_en")
  isActive     Boolean    @default(true) @map("activo")
  permission   Permission @relation(fields: [permissionId], references: [id])
  service      Service    @relation(fields: [serviceId], references: [id])

  @@id([serviceId, permissionId])
  @@map("servicio_permiso")
}

model ConfirmationStatus {
  id        Int      @id @default(autoincrement()) @map("id_estado")
  status    String   @unique @map("estado") @db.VarChar(30)
  createdAt DateTime @default(now()) @map("creado_en")
  updatedAt DateTime @updatedAt @map("actualizado_en")
  isActive  Boolean  @default(true) @map("activo")
  users     User[]

  @@map("estados_confirmacion")
}

model User {
  id                   String             @id @default(uuid()) @map("id_usuario")
  email                String             @unique @map("correo") @db.VarChar(50)
  confirmationStatusId Int                @default(2) @map("id_estado_confirmacion")
  isActive             Boolean            @default(true) @map("activo")
  roleId               Int                @map("id_rol")
  createdAt            DateTime           @default(now()) @map("creado_en")
  updatedAt            DateTime           @updatedAt @map("actualizado_en")
  lastSignInAt         DateTime?          @map("ultimoInicioSesion")
  firstName            String             @db.VarChar(50)
  lastName             String             @db.VarChar(50)
  password             String?            @map("contrasena")
  authMethod           AuthMethod?        @map("metodo_auth")
  microsoftOid         String?            @map("microsoft_oid")
  jurorCategory        JurorCategory?     @map("categoria_jurado")
  jurorType            JurorType?         @map("tipo_jurado")
  createdTeam          Team?              @relation("createdTeam")
  evaluationsSubmitted Evaluation[]       @relation("JurorEvaluations")
  managedNrcs          NRC[]              @relation("ProfessorNRC")
  confirmationStatus   ConfirmationStatus @relation(fields: [confirmationStatusId], references: [id])
  role                 Role               @relation(fields: [roleId], references: [id])
  likedVideogames      VideogameLike[]
  teamsToEvaluate      Team[]             @relation("JurorTeamAssignment")
  jurorBadges          JurorBadge[]
  attendances          JurorAttendance[]  @relation("JurorAttendance")
  recordedAttendances  JurorAttendance[]  @relation("AttendanceRecorder")
  teamVerifications    TeamVerification[]
  jurorEditions        JurorEdition[]
  refreshTokens        RefreshToken[]

  @@index([jurorCategory])
  @@index([jurorType])
  @@map("usuarios")
}

model Team {
  id               Int             @id @default(autoincrement()) @map("id_equipo")
  teamName         String          @unique @map("nombre_equipo") @db.VarChar(50)
  registrationDate DateTime        @default(now()) @map("fecha_registro")
  userId           String          @unique @map("id_usuario")
  editionId        Int             @map("id_edicion")
  isActive         Boolean         @default(true) @map("activo")
  isExternal       Boolean         @default(false) @map("externo")
  teamCode         String          @map("codigo_equipo") @db.VarChar(12)
  // Código que el estudiante ve en su panel y el jurado digita para calificar (HU-19). Null en equipos N0 (colegios).
  verificationCode String?         @map("codigo_verificacion") @db.VarChar(8)
  edition          Edition         @relation(fields: [editionId], references: [id])
  user             User            @relation("createdTeam", fields: [userId], references: [id])
  members          Member[]        @relation("TeamMembers")
  videogame        Videogame?
  assignedJurors   User[]          @relation("JurorTeamAssignment")
  rankingResults   RankingResult[]
  verifications    TeamVerification[]

  @@unique([teamCode, editionId])
  @@unique([verificationCode, editionId])
  @@map("equipos")
}

// Jurado que ya digitó el código de verificación de un equipo (se pide una sola vez por grupo).
model TeamVerification {
  id        Int      @id @default(autoincrement()) @map("id_verificacion")
  teamId    Int      @map("id_equipo")
  jurorId   String   @map("id_jurado")
  createdAt DateTime @default(now()) @map("creado_en")
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  juror     User     @relation(fields: [jurorId], references: [id])

  @@unique([teamId, jurorId])
  @@map("verificacion_equipo")
}

enum TeamVerificationAction {
  ATTEMPT_SUCCESS
  ATTEMPT_FAILED
  CODE_VIEWED
  CODE_REGENERATED
}

// Registro de intentos y acciones del administrador sobre el código de verificación.
model TeamVerificationLog {
  id        Int                    @id @default(autoincrement()) @map("id_registro")
  action    TeamVerificationAction @map("accion")
  teamId    Int                    @map("id_equipo")
  userId    String                 @map("id_usuario")
  createdAt DateTime               @default(now()) @map("creado_en")

  @@index([teamId, userId, action, createdAt], map: "registro_verificacion_equipo_intentos_idx")
  @@map("registro_verificacion_equipo")
}

model HistoricalTeam {
  id         Int                  @id @default(autoincrement()) @map("id_equipo_historico")
  teamName   String               @map("nombre_equipo") @db.VarChar(50)
  editionId  Int                  @map("id_edicion")
  isExternal Boolean              @default(false) @map("externo")
  teamCode   String               @map("codigo_equipo") @db.VarChar(12)
  edition    Edition              @relation(fields: [editionId], references: [id])
  members    HistoricalMember[]   @relation("HistoricalTeamMembers")
  videogame  HistoricalVideogame?

  @@unique([teamCode, editionId])
  @@map("equipos_historico")
}

model Member {
  id          Int      @id @default(autoincrement()) @map("id_integrante")
  firstName   String   @map("nombre") @db.VarChar(50)
  lastName    String   @map("apellido") @db.VarChar(50)
  email       String   @unique @map("correo") @db.VarChar(100)
  studentCode String   @unique @map("codigo_estudiantil") @db.VarChar(100)
  teamId      Int      @map("id_equipo")
  isActive    Boolean  @default(true) @map("activo")
  updatedAt   DateTime @updatedAt @map("actualizado_en")
  createdAt   DateTime @default(now()) @map("creado_en")
  team        Team     @relation("TeamMembers", fields: [teamId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  nrcs        NRC[]    @relation("MemberNRC")

  @@map("integrante")
}

model HistoricalMember {
  id          Int            @id @default(autoincrement()) @map("id_integrante_historico")
  firstName   String         @map("nombre") @db.VarChar(50)
  lastName    String         @map("apellido") @db.VarChar(50)
  email       String         @map("correo") @db.VarChar(100)
  studentCode String         @map("codigo_estudiantil") @db.VarChar(100)
  teamId      Int            @map("id_equipo_historico")
  team        HistoricalTeam @relation("HistoricalTeamMembers", fields: [teamId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  nrcs        HistoricalMemberNrc[]

  @@map("integrante_historico")
}

// Immutable NRC association copied at archive time; nrcId is a snapshot value,
// intentionally without a foreign key to the mutable current NRC table.
model HistoricalMemberNrc {
  id                Int              @id @default(autoincrement())
  historicalMemberId Int              @map("id_integrante_historico")
  nrcId             Int              @map("id_nrc")
  code              Int              @map("codigo")
  member            HistoricalMember @relation(fields: [historicalMemberId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([historicalMemberId, nrcId])
  @@index([nrcId])
  @@map("integrante_historico_nrc")
}

model VideogameStatus {
  id         Int         @id @default(autoincrement()) @map("id_estado")
  status     String      @unique @map("estado") @db.VarChar(30)
  isActive   Boolean     @default(true) @map("activo")
  updatedAt  DateTime    @updatedAt @map("actualizado_en")
  createdAt  DateTime    @default(now()) @map("creado_en")
  videogames Videogame[]

  @@map("estado_videojuego")
}

model Videogame {
  id                Int             @id @default(autoincrement()) @map("id_videojuego")
  name              String          @map("nombre") @db.VarChar(30)
  description       String?         @map("descripcion")
  logoUrl           String?         @map("logo_url")
  registrationDate  DateTime        @default(now()) @map("fecha_registro")
  videogameStatusId Int             @default(2) @map("id_estado_videojuego")
  teamId            Int             @unique @map("id_equipo")
  isActive          Boolean         @default(true) @map("activo")
  repoUrl           String?         @map("repo_url")
  videoUrl          String?         @map("video_url")
  additionalImages  String[]        @default([]) @map("imagenes_adicionales")
  team              Team            @relation(fields: [teamId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  videogameStatus   VideogameStatus @relation(fields: [videogameStatusId], references: [id])
  gameFileUrl       String?         @map("archivo_videojuego_url")
  entry             String?

  highlightedGames HighlightedGame[]
  evaluations      Evaluation[]
  likedBy          VideogameLike[]
  rankingResults   RankingResult[]

  @@map("videojuegos")
}

model HistoricalVideogame {
  id               Int            @id @default(autoincrement()) @map("id_videojuego_historico")
  name             String         @map("nombre") @db.VarChar(30)
  description      String?        @map("descripcion")
  logoUrl          String?        @map("logo_url")
  teamId           Int            @unique @map("id_equipo_historico")
  repoUrl          String?        @map("repo_url")
  videoUrl         String?        @map("video_url")
  additionalImages String[]       @default([]) @map("imagenes_adicionales")
  historicalTeam   HistoricalTeam @relation(fields: [teamId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  gameFileUrl      String?        @map("archivo_videojuego_url")
  entry            String?
  likes            Int            @default(0) @map("likes")
  finalScore       Float?         @map("puntaje_final")

  @@map("videojuegos_historico")
}

model VideogameLike {
  id          Int       @id @default(autoincrement())
  videogameId Int       @map("id_videojuego")
  createdAt   DateTime  @default(now()) @map("created_at")
  userId      String    @map("user_id")
  videogame   Videogame @relation(fields: [videogameId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([videogameId, userId])
  @@map("videogame_likes")
}

model HighlightedGame {
  id          Int       @id @default(autoincrement()) @map("id_juego_destacado")
  editionId   Int       @map("id_edicion")
  videogameId Int       @map("id_videojuego")
  createdAt   DateTime  @default(now()) @map("creado_en")
  updatedAt   DateTime  @updatedAt @map("actualizado_en")
  edition     Edition   @relation(fields: [editionId], references: [id])
  videogame   Videogame @relation(fields: [videogameId], references: [id])

  @@unique([editionId, videogameId])
  @@map("juego_destacado")
}

model Evaluation {
  id          Int                @id @default(autoincrement()) @map("id_evaluacion")
  date        DateTime           @default(now()) @map("fecha")
  comments    String?            @map("comentarios")
  totalScore  Float?             @map("puntaje_total")
  jurorId     String             @map("id_jurado")
  videogameId Int                @map("id_videojuego")
  editionId   Int                @map("id_edicion")
  isActive    Boolean            @default(true) @map("activo")
  isSenior    Boolean            @default(false) @map("es_jurado_senior")
  contentHash String             @default("") @map("content_hash")
  idempotencyKey String?         @map("idempotency_key")
  details     EvaluationDetail[]
  Edition     Edition            @relation(fields: [editionId], references: [id])
  juror       User               @relation("JurorEvaluations", fields: [jurorId], references: [id])
  videogame   Videogame          @relation(fields: [videogameId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([jurorId, videogameId], name: "jurado_videojuego_unique")
  @@map("evaluacion")
}

model EvaluationIdempotency {
  id             Int    @id @default(autoincrement())
  jurorId        String @map("juror_id")
  key            String
  contentHash    String @map("content_hash")
  response       Json

  @@unique([jurorId, key])
  @@map("evaluation_idempotency")
}

model JurorAssignmentAuditLog {
  id              Int                         @id @default(autoincrement())
  action          ManualJurorAssignmentAction
  actorUserId     String                      @map("actor_user_id")
  teamId          Int?                        @map("team_id")
  jurorId         String?                     @map("juror_id")
  previousJurorId String?                     @map("previous_juror_id")
  newJurorId      String?                     @map("new_juror_id")
  notes           String?
  createdAt       DateTime                    @default(now()) @map("created_at")

  @@index([actorUserId])
  @@index([teamId])
  @@index([jurorId])
  @@index([createdAt])
  @@map("juror_assignment_audit_logs")
}

// Escarapela de un jurado en una edición. El token es el contenido opaco del QR.
// La unicidad de (jurorId, editionId) entre activas se garantiza con un índice
// parcial creado a mano en la migración (Prisma no lo soporta).
model JurorBadge {
  id        Int      @id @default(autoincrement()) @map("id_escarapela")
  jurorId   String   @map("id_usuario")
  editionId Int      @map("id_edicion")
  token     String   @unique @map("token")
  isActive  Boolean  @default(true) @map("activo")
  createdAt DateTime @default(now()) @map("creado_en")
  juror     User     @relation(fields: [jurorId], references: [id])
  edition   Edition  @relation(fields: [editionId], references: [id])

  attendances JurorAttendance[]

  @@index([editionId])
  @@map("escarapelas_jurado")
}

enum CheckInMethod {
  QR
  MANUAL
}

// HU-11: llegada de un jurado a la feria. A lo sumo un registro activo por jurado y
// edición (índice único parcial en la migración: no lo expresa Prisma).
model JurorAttendance {
  id            Int           @id @default(autoincrement()) @map("id_asistencia")
  jurorId       String        @map("id_usuario")
  editionId     Int           @map("id_edicion")
  checkedInAt   DateTime      @default(now()) @map("registrado_en")
  checkedInById String        @map("registrado_por")
  method        CheckInMethod @map("metodo")
  badgeId       Int?          @map("id_escarapela")
  isActive      Boolean       @default(true) @map("activo")
  juror         User          @relation("JurorAttendance", fields: [jurorId], references: [id])
  checkedInBy   User          @relation("AttendanceRecorder", fields: [checkedInById], references: [id])
  edition       Edition       @relation(fields: [editionId], references: [id])
  badge         JurorBadge?   @relation(fields: [badgeId], references: [id])

  @@index([editionId])
  @@map("asistencia_jurado")
}

model Subject {
  id        Int      @id @default(autoincrement()) @map("id_materia")
  name      String   @map("nombre") @db.VarChar(50)
  code      String   @map("codigo") @db.VarChar(50)
  semester  Int      @map("semestre")
  isActive  Boolean  @default(true) @map("activo")
  updatedAt DateTime @updatedAt @map("actualizado_en")
  createdAt DateTime @default(now()) @map("creado_en")
  abrevName String   @default("IST") @map("abreviacion") @db.Char(3)
  nrcs      NRC[]

  @@map("materia")
}

model NRC {
  id          Int      @id @default(autoincrement()) @map("id_nrc")
  code        Int      @map("codigo")
  subjectId   Int      @map("id_materia")
  professorId String   @map("id_profesor")
  isActive    Boolean  @default(true) @map("activo")
  updatedAt   DateTime @updatedAt @map("actualizado_en")
  createdAt   DateTime @default(now()) @map("creado_en")
  editionId   Int      @map("id_edicion")
  edition     Edition  @relation(fields: [editionId], references: [id])
  subject     Subject  @relation(fields: [subjectId], references: [id])
  professor   User     @relation("ProfessorNRC", fields: [professorId], references: [id])
  members     Member[] @relation("MemberNRC")

  @@map("nrc")
}

model Criterion {
  id                Int                @id @default(autoincrement()) @map("id_criterio")
  name              String             @map("nombre") @db.VarChar(50)
  description       String?            @map("descripcion")
  weight            Float?             @map("peso")
  isActive          Boolean            @default(true) @map("activo")
  updatedAt         DateTime           @updatedAt @map("actualizado_en")
  createdAt         DateTime           @default(now()) @map("creado_en")
  evaluationDetails EvaluationDetail[]

  @@map("criterios")
}

model EvaluationDetail {
  id           Int        @id @default(autoincrement()) @map("id_detalle")
  score        Float      @map("puntaje")
  evaluationId Int        @map("id_evaluacion")
  criterionId  Int        @map("id_criterio")
  isActive     Boolean    @default(true) @map("activo")
  updatedAt    DateTime   @updatedAt @map("actualizado_en")
  createdAt    DateTime   @default(now()) @map("creado_en")
  criterion    Criterion  @relation(fields: [criterionId], references: [id])
  evaluation   Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([evaluationId, criterionId], name: "evaluacion_criterio_unique")
  @@map("detalle_evaluacion")
}

model Weighting {
  id        Int      @id @default(autoincrement())
  editionId Int      @unique @map("id_edicion")
  seniorPct Float    @map("senior_pct")
  juniorPct Float    @map("junior_pct")
  createdAt DateTime @default(now()) @map("creado_en")
  updatedAt DateTime @updatedAt @map("actualizado_en")
  edition   Edition  @relation(fields: [editionId], references: [id])

  @@map("ponderado")
}

model Upload {
  id        String   @id @default(uuid())
  blobName  String
  filename  String
  mimetype  String
  size      Int
  entry     String?
  isPublic  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("archivos_subidos")
}

model RankingResult {
  id          Int @id @default(autoincrement())
  teamId      Int @map("id_equipo")
  videogameId Int @map("id_videojuego")
  editionId   Int @map("id_edicion")

  baseScore                Float  @map("puntaje_base")
  rankingScore             Float  @map("puntaje_ranking")
  tieBreakerScore          Float? @map("puntaje_desempate")
  jurorTieBreakerScore     Float? @map("puntaje_desempate_jurados")
  professorTieBreakerScore Float? @map("puntaje_desempate_profesores")

  wasTied       Boolean @default(false) @map("hubo_empate")
  finalPosition Int     @map("posicion_final")

  createdAt DateTime @default(now()) @map("creado_en")
  updatedAt DateTime @updatedAt @map("actualizado_en")

  team      Team      @relation(fields: [teamId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  videogame Videogame @relation(fields: [videogameId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  edition   Edition   @relation(fields: [editionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([teamId, videogameId, editionId])
  @@index([editionId])
  @@index([finalPosition])
  @@map("resultado_ranking")
}

model EducationalFocus {
  id          Int      @id @default(autoincrement()) @map("id_enfoque")
  editionId   Int      @map("id_edicion")
  title       String   @map("titulo") @db.VarChar(100)
  description String?  @map("descripcion")
  isActive    Boolean  @default(true) @map("activo")
  createdAt   DateTime @default(now()) @map("creado_en")
  updatedAt   DateTime @updatedAt @map("actualizado_en")
  edition     Edition  @relation(fields: [editionId], references: [id])

  @@map("enfoque_educativo")
}

model Testimonial {
  id        Int      @id @default(autoincrement()) @map("id_testimonio")
  editionId Int      @map("id_edicion")
  name      String   @map("nombre") @db.VarChar(100)
  role      String   @map("rol") @db.VarChar(100)
  quote     String   @map("cita")
  isActive  Boolean  @default(true) @map("activo")
  createdAt DateTime @default(now()) @map("creado_en")
  updatedAt DateTime @updatedAt @map("actualizado_en")
  edition   Edition  @relation(fields: [editionId], references: [id])

  @@map("testimonio")
}

view TeamFinalScore {
  teamId           Int     @map("team_id")
  teamCode         String? @map("team_code") @db.VarChar(12)
  teamName         String? @map("team_name") @db.VarChar(50)
  isExternal       Boolean @map("is_external")
  videogameId      Int     @map("videogame_id")
  videogameName    String? @map("videogame_name") @db.VarChar(30)
  videogameLogoUrl String? @map("videogame_logo_url")
  editionId        Int     @map("edition_id")
  avgJunior        Float?  @map("avg_junior")
  avgSenior        Float?  @map("avg_senior")
  finalScore       Float?  @map("final_score")

  @@unique([teamId, videogameId, editionId])
  @@map("vw_team_final_scores")
}

enum AuthMethod {
  PASSWORD
  ENTRA_ID
}

enum JurorCategory {
  JUNIOR
  SENIOR
}

enum JurorType {
  OFFICIAL
  BACKUP
}

enum ManualJurorAssignmentAction {
  ASSIGN
  UNASSIGN
  REASSIGN
  UNASSIGN_ALL
  UNASSIGN_ALL_FROM_EVALUATOR
}

// HU-25: participación de un jurado (rol Jurado) en una edición. La cuenta se conserva entre
// ediciones; aquí se guarda si viene a esta (Pendiente, Confirmado, Declinó) y si es Oficial o
// Suplente. Los profesores no tienen fila: son jurados de la edición si tienen un NRC activo en ella.
// Sin isActive: Declinó cumple esa función y hay una sola fila por jurado y edición.
model JurorEdition {
  id          Int                @id @default(autoincrement()) @map("id_jurado_edicion")
  jurorId     String             @map("id_usuario")
  editionId   Int                @map("id_edicion")
  status      JurorEditionStatus @default(PENDING) @map("estado")
  type        JurorType          @default(OFFICIAL) @map("tipo")
  createdAt   DateTime           @default(now()) @map("creado_en")
  updatedAt   DateTime           @updatedAt @map("actualizado_en")
  // Id del administrador que hizo el último cambio (sin llave foránea, solo auditoría).
  updatedById String?            @map("actualizado_por")
  juror       User               @relation(fields: [jurorId], references: [id])
  edition     Edition            @relation(fields: [editionId], references: [id])

  @@unique([jurorId, editionId])
  @@index([editionId, status])
  @@map("jurado_edicion")
}

enum JurorEditionStatus {
  PENDING
  CONFIRMED
  DECLINED
}
