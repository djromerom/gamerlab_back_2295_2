  editionId Int      @map("id_edicion")
  name      String   @map("nombre") @db.VarChar(100)
  role      String   @map("rol") @db.VarChar(100)
  quote     String   @map("cita")
  isActive  Boolean  @default(true) @map("activo")
  createdAt DateTime @default(now()) @map("creado_en")
  updatedAt DateTime @updatedAt @map("actualizado_en")
  edition   Edition  @relation(fields: [editionId], references: [id])

  @@map("testimonio")
}

view TeamFinalScore {
  teamId           Int     @map("team_id")
  teamCode         String? @map("team_code") @db.VarChar(12)
  teamName         String? @map("team_name") @db.VarChar(50)
  isExternal       Boolean @map("is_external")
  videogameId      Int     @map("videogame_id")
  videogameName    String? @map("videogame_name") @db.VarChar(30)
  videogameLogoUrl String? @map("videogame_logo_url")
  editionId        Int     @map("edition_id")
  avgJunior        Float?  @map("avg_junior")
  avgSenior        Float?  @map("avg_senior")
  // HU-34: null si falta una de las dos partes («Nota en proceso»), salvo externos, N0 y ediciones congeladas.
  finalScore       Float?  @map("final_score")
  // HU-04: evaluaciones activas con nota. Junior = jurados (solo cuentan las 3 primeras); senior = profesor.
  juniorEvaluations   Int     @map("junior_evaluations")
  juniorCounted       Int     @map("junior_counted")
  seniorEvaluations   Int     @map("senior_evaluations")
  weightingConfigured Boolean @map("weighting_configured")
  legacyFinalScoreRule Boolean @map("legacy_final_score_rule")

  @@unique([teamId, videogameId, editionId])
  @@map("vw_team_final_scores")
}

enum AuthMethod {
  PASSWORD
  ENTRA_ID
}

enum JurorCategory {
  JUNIOR
  SENIOR
}

enum JurorType {
  OFFICIAL
  BACKUP
}

enum ManualJurorAssignmentAction {
  ASSIGN
  UNASSIGN
  REASSIGN
  UNASSIGN_ALL
  UNASSIGN_ALL_FROM_EVALUATOR
}

// HU-25: participación de un jurado (rol Jurado) en una edición. La cuenta se conserva entre
// ediciones; aquí se guarda si viene a esta (Pendiente, Confirmado, Declinó) y si es Oficial o
// Suplente. Los profesores no tienen fila: son jurados de la edición si tienen un NRC activo en ella.
// Sin isActive: Declinó cumple esa función y hay una sola fila por jurado y edición.
/// HU-12: cronograma del día de la feria, uno por edición. Horas "HH:mm" en hora de Bogotá.
model FairSchedule {
  id          Int      @id @default(autoincrement()) @map("id_cronograma")
  editionId   Int      @unique @map("id_edicion")
  fairDate    DateTime @map("fecha_feria") @db.Date
  startTime   String   @map("hora_inicio") @db.VarChar(5)
  alertTime   String   @map("hora_alerta") @db.VarChar(5)
  controlTime String   @map("hora_control") @db.VarChar(5)
  closeTime   String   @map("hora_cierre") @db.VarChar(5)
  createdAt   DateTime @default(now()) @map("creado_en")
  updatedAt   DateTime @updatedAt @map("actualizado_en")
  // Id del administrador que hizo el último cambio (sin llave foránea, solo auditoría).
  updatedById String?  @map("actualizado_por")
  edition     Edition  @relation(fields: [editionId], references: [id])

  @@map("cronograma_feria")
}

model JurorEdition {
  id          Int                @id @default(autoincrement()) @map("id_jurado_edicion")
  jurorId     String             @map("id_usuario")
  editionId   Int                @map("id_edicion")
  status      JurorEditionStatus @default(PENDING) @map("estado")
  type        JurorType          @default(OFFICIAL) @map("tipo")
  // HU-24: el administrador lo dio de alta el día de la feria (llegó sin estar registrado).
  walkIn      Boolean            @default(false) @map("alta_dia_feria")
  createdAt   DateTime           @default(now()) @map("creado_en")
  updatedAt   DateTime           @updatedAt @map("actualizado_en")
  // Id del administrador que hizo el último cambio (sin llave foránea, solo auditoría).
  updatedById String?            @map("actualizado_por")
  juror       User               @relation(fields: [jurorId], references: [id])
  edition     Edition            @relation(fields: [editionId], references: [id])

  @@unique([jurorId, editionId])
  @@index([editionId, status])
  @@map("jurado_edicion")
}

enum JurorEditionStatus {
  PENDING
  CONFIRMED
  DECLINED
}

/// HU-13: lo que los profesores averiguaron de un jurado que no llegó.
enum AbsentJurorResponseResult {
  ON_THE_WAY // viene en camino
  CANNOT_ATTEND // no podrá asistir
  NO_RESPONSE // sin respuesta
}

// HU-13: historial de respuestas sobre un jurado sin llegada registrada. Cada registro es una fila
// nueva y no se edita ni se borra (por eso no lleva isActive): la última fila es la vigente y una
// equivocación se corrige con otro registro. Es informativo: no cambia las reglas de cobertura.
model AbsentJurorResponse {
  id                 Int                       @id @default(autoincrement()) @map("id_respuesta")
  jurorId            String                    @map("id_usuario")
  editionId          Int                       @map("id_edicion")
  result             AbsentJurorResponseResult @map("resultado")
  estimatedArrivalAt DateTime?                 @map("hora_estimada")
  recordedAt         DateTime                  @default(now()) @map("registrado_en")
  recordedById       String                    @map("registrado_por")
  juror              User                      @relation("AbsentResponseJuror", fields: [jurorId], references: [id])
  recordedBy         User                      @relation("AbsentResponseRecorder", fields: [recordedById], references: [id])
  edition            Edition                   @relation(fields: [editionId], references: [id])

  @@index([editionId, jurorId, recordedAt])
  @@map("respuesta_jurado_ausente")
}

/// HU-04: cómo se resolvió un empate del ranking por nivel.
enum TieBreakMethod {
  PROFESSOR // el profesor de los grupos empatados eligió el orden
  REGISTRATION // primero el grupo inscrito antes
  ADMIN // resolución manual del administrador (p. ej. misma fecha de inscripción)
}

/// HU-04: decisión registrada sobre un empate. Un empate se identifica por `tieKey`
/// (edición, nivel, nota y equipos); si cambian las notas, el empate es otro y la decisión deja de aplicar.
model TieBreakDecision {
  id             Int            @id @default(autoincrement()) @map("id_decision")
  editionId      Int            @map("id_edicion")
  level          Int            @map("nivel")
  score          Float          @map("nota")
  tieKey         String         @unique @map("clave_empate") @db.VarChar(255)
  teamIds        Int[]          @map("equipos_empatados")
  orderedTeamIds Int[]          @map("orden_final")
  method         TieBreakMethod @map("metodo")
  reason         String         @map("motivo") @db.VarChar(500)
  decidedById    String         @map("id_usuario")
  createdAt      DateTime       @default(now()) @map("creado_en")
  edition        Edition        @relation(fields: [editionId], references: [id], onDelete: Cascade)
  decidedBy      User           @relation(fields: [decidedById], references: [id])

  @@index([editionId, level])
  @@map("decision_desempate")
}
