// Escarapela de un jurado en una edición. El token es el contenido opaco del QR.
// La unicidad de (jurorId, editionId) entre activas se garantiza con un índice
// parcial creado a mano en la migración (Prisma no lo soporta).
model JurorBadge {
  id        Int      @id @default(autoincrement()) @map("id_escarapela")
  jurorId   String   @map("id_usuario")
  editionId Int      @map("id_edicion")
  token     String   @unique @map("token")
  isActive  Boolean  @default(true) @map("activo")
  createdAt DateTime @default(now()) @map("creado_en")
  juror     User     @relation(fields: [jurorId], references: [id])
  edition   Edition  @relation(fields: [editionId], references: [id])

  attendances JurorAttendance[]

  @@index([editionId])
  @@map("escarapelas_jurado")
}

enum CheckInMethod {
  QR
  MANUAL
}

// HU-11: llegada de un jurado a la feria. A lo sumo un registro activo por jurado y
// edición (índice único parcial en la migración: no lo expresa Prisma).
model JurorAttendance {
  id            Int           @id @default(autoincrement()) @map("id_asistencia")
  jurorId       String        @map("id_usuario")
  editionId     Int           @map("id_edicion")
  checkedInAt   DateTime      @default(now()) @map("registrado_en")
  checkedInById String        @map("registrado_por")
  method        CheckInMethod @map("metodo")
  badgeId       Int?          @map("id_escarapela")
  isActive      Boolean       @default(true) @map("activo")
  // HU-23: último "Sigo aquí" del jurado. Null = no ha respondido desde su llegada.
  lastPresenceConfirmedAt DateTime? @map("ultima_confirmacion_presencia")
  juror         User          @relation("JurorAttendance", fields: [jurorId], references: [id])
  checkedInBy   User          @relation("AttendanceRecorder", fields: [checkedInById], references: [id])
  edition       Edition       @relation(fields: [editionId], references: [id])
  badge         JurorBadge?   @relation(fields: [badgeId], references: [id])

  @@index([editionId])
  @@map("asistencia_jurado")
}

// HU-37: suscripción a notificaciones push de un dispositivo (la dirección `endpoint` es única
// por navegador). Desuscribirse la desactiva; las vencidas (404/410) se borran físicamente.
model PushSubscription {
  id        Int      @id @default(autoincrement()) @map("id_suscripcion")
  userId    String   @map("id_usuario")
  endpoint  String   @unique @db.VarChar(2048)
  p256dh    String   @map("clave_p256dh") @db.VarChar(128)
  auth      String   @map("clave_auth") @db.VarChar(64)
  isActive  Boolean  @default(true) @map("activo")
  createdAt DateTime @default(now()) @map("creado_en")
  updatedAt DateTime @updatedAt @map("actualizado_en")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@map("suscripcion_push")
}

// HU-22 (ARK-84): estado del correo del aviso al suplente. SKIPPED = sin claves de ACS en desarrollo
// (modo simulación, no salió ningún correo).
enum SubstituteNoticeEmailStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

// HU-22 (ARK-84): aviso "Te asignaron grupos" a un suplente (tipo BACKUP en la edición). Uno por
// operación de asignación; queda activo hasta que el suplente lo marca como leído.
model SubstituteNotice {
  id          Int                         @id @default(autoincrement()) @map("id_aviso")
  jurorId     String                      @map("id_jurado")
  editionId   Int                         @map("id_edicion")
  createdAt   DateTime                    @default(now()) @map("creado_en")
  // Null = sin leer.
  readAt      DateTime?                   @map("leido_en")
  emailStatus SubstituteNoticeEmailStatus @default(PENDING) @map("estado_correo")
  // Motivo corto del fallo del correo, sin datos personales.
  emailError  String?                     @map("error_correo") @db.VarChar(200)
  juror       User                        @relation(fields: [jurorId], references: [id])
  edition     Edition                     @relation(fields: [editionId], references: [id])
  teams       SubstituteNoticeTeam[]

  @@index([jurorId, editionId, readAt])
  @@index([editionId, readAt])
  @@map("aviso_suplente")
}

// HU-22 (ARK-84): grupos de un aviso, con una foto del código, nombre, videojuego y nivel al
// momento de asignar: el aviso se sigue leyendo igual aunque el equipo cambie o se elimine.
model SubstituteNoticeTeam {
  id            Int              @id @default(autoincrement()) @map("id_aviso_equipo")
  noticeId      Int              @map("id_aviso")
  teamId        Int?             @map("id_equipo")
  teamCode      String           @map("codigo_equipo") @db.VarChar(12)
  teamName      String           @map("nombre_equipo") @db.VarChar(50)
  videogameName String?          @map("nombre_videojuego") @db.VarChar(30)
  // 0 = colegios; null si el código no trae nivel.
  level         Int?             @map("nivel")
  notice        SubstituteNotice @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  team          Team?            @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@unique([noticeId, teamId])
  @@index([teamId])
  @@map("aviso_suplente_equipo")
}

model Subject {
  id        Int      @id @default(autoincrement()) @map("id_materia")
  name      String   @map("nombre") @db.VarChar(50)
  code      String   @map("codigo") @db.VarChar(50)
  semester  Int      @map("semestre")
  isActive  Boolean  @default(true) @map("activo")
  updatedAt DateTime @updatedAt @map("actualizado_en")
  createdAt DateTime @default(now()) @map("creado_en")
  abrevName String   @default("IST") @map("abreviacion") @db.Char(3)
  nrcs      NRC[]

  @@map("materia")
}

model NRC {
  id          Int      @id @default(autoincrement()) @map("id_nrc")
  code        Int      @map("codigo")
  subjectId   Int      @map("id_materia")
  professorId String   @map("id_profesor")
  isActive    Boolean  @default(true) @map("activo")
  updatedAt   DateTime @updatedAt @map("actualizado_en")
  createdAt   DateTime @default(now()) @map("creado_en")
  editionId   Int      @map("id_edicion")
  edition     Edition  @relation(fields: [editionId], references: [id])
  subject     Subject  @relation(fields: [subjectId], references: [id])
  professor   User     @relation("ProfessorNRC", fields: [professorId], references: [id])
  members     Member[] @relation("MemberNRC")

  @@map("nrc")
}

model Criterion {
  id                Int                @id @default(autoincrement()) @map("id_criterio")
  name              String             @map("nombre") @db.VarChar(50)
  description       String?            @map("descripcion")
  weight            Float?             @map("peso")
  isActive          Boolean            @default(true) @map("activo")
  updatedAt         DateTime           @updatedAt @map("actualizado_en")
  createdAt         DateTime           @default(now()) @map("creado_en")
  evaluationDetails EvaluationDetail[]

  @@map("criterios")
}

model EvaluationDetail {
  id           Int        @id @default(autoincrement()) @map("id_detalle")
  score        Float      @map("puntaje")
  evaluationId Int        @map("id_evaluacion")
  criterionId  Int        @map("id_criterio")
  isActive     Boolean    @default(true) @map("activo")
  updatedAt    DateTime   @updatedAt @map("actualizado_en")
  createdAt    DateTime   @default(now()) @map("creado_en")
  criterion    Criterion  @relation(fields: [criterionId], references: [id])
  evaluation   Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([evaluationId, criterionId], name: "evaluacion_criterio_unique")
  @@map("detalle_evaluacion")
}

model Weighting {
  id        Int      @id @default(autoincrement())
  editionId Int      @unique @map("id_edicion")
  seniorPct Float    @map("senior_pct")
  juniorPct Float    @map("junior_pct")
  createdAt DateTime @default(now()) @map("creado_en")
  updatedAt DateTime @updatedAt @map("actualizado_en")
  edition   Edition  @relation(fields: [editionId], references: [id])

